# The credentials for the model providers and the examples. Copy this file to
# .env and fill in the values you need. Git ignores .env.
#
# make credentials creates one Secret for each value that is set and skips
# the empty ones. Make reads this file. Write each value without quotes.

# The OpenRouter API key, for providers/openrouter.yaml.
# Create one at https://openrouter.ai/keys.
OPENROUTER_API_KEY=

# The Exa API key, for the exa MCP server in ../multi-tenant/sre.
# Create one at https://dashboard.exa.ai/api-keys.
EXA_API_KEY=

# The absolute path to your GitHub App's private key file, for the github
# connection in ../multi-tenant/engineering. GitHub gives you the .pem file when
# you generate a private key in the App's settings.
GITHUB_APP_PRIVATE_KEY_FILE=
